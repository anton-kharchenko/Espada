{
  "info": {
    "name": "Espada REST API",
    "description": "Runnable examples for every current Espada REST endpoint.\n\nSetup:\n1. Import this collection and Local_Environment.postman_environment.json.\n2. Select the Espada Local environment.\n3. Read the local key with `aspire secret get Parameters:api-key --apphost src/Aspire/Aspire.csproj` and set the secret apiKey environment variable.\n4. Run folders in numeric order. IDs are captured automatically into the environment.\n\nThe Generate Chunk Embedding request requires a configured embedding provider and is the only request not asserted in the default local setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Espada-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "[\"baseUrl\", \"apiKey\"].forEach((key) => {",
          "  if (!pm.environment.get(key)) {",
          "    throw new Error(`Select the Espada Local environment and set ${key}.`);",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Workspace",
      "description": "Creates the workspace used by the remaining requests and stores workspaceId.",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/{{apiVersion}}/workspaces",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman workspace\",\n  \"typeId\": {{workspaceTypeId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "pm.expect(response.workspaceId, \"workspaceId\").to.exist;",
                  "pm.environment.set(\"workspaceId\", response.workspaceId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{apiVersion}}/workspaces/{{workspaceId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
